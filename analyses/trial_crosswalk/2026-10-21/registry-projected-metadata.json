      "outcomesModule": {
        "primaryOutcomes": [
          {
            "measure": "Yale Global Tic Severity Scale_(YGTSS) - Total Tic Score",
            "description": "The YGTSS is a clinician-rated scale used to assess tic severity over the prior week. It includes a checklist of motor and vocal tics followed by an assessment of the number, frequency, intensity, complexity, and inference of motor tics and phonic tics - scored separately. Each of these dimensions is scored on a 0 to 5 scale. The YGTSS provides three tic severity scores: Total Motor (0 to 25); Total Phonic (0 to 25) and the combined Total Tic Severity Score (0 to 50), as well as a separate Impairment dimension scored from 0 to 50. The Total Tic Score (YGTSS-TTS) was used in these analyses.",
            "timeFrame": "9 months"
          }
        ]
      },
